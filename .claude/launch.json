{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8090"
      ],
      "cwd": "apps/mobile",
      "port": 8090
    },
    {
      "name": "dev-client",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "expo-tunnel",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--tunnel"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "expo-tunnel-8082",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--tunnel",
        "--port",
        "8082"
      ],
      "cwd": "apps/mobile",
      "port": 8082
    }
  ]
}
