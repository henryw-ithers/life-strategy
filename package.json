{
  "name": "glide",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-screens": "~4.26.0",
    "react-native-safe-area-context": "~5.7.0",
    "expo-sqlite": "~57.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "postinstall": "patch-package && node scripts/setup-skia-web.mjs",
    "content:build": "node scripts/content/build.mjs",
    "content:check": "node scripts/content/build.mjs --check",
    "test": "npm run content:check && npm run test -w packages/scoring && npm run test -w packages/backup && npm run test -w apps/mobile",
    "typecheck": "npm run typecheck -w packages/scoring && npm run typecheck -w packages/backup && npm run typecheck -w apps/mobile",
    "lint": "npm run lint -w apps/mobile",
    "mobile": "npm run start -w apps/mobile",
    "build:ios": "npm run eas:build -w apps/mobile",
    "submit:ios": "npm run eas:submit -w apps/mobile"
  },
  "version": "1.0.0",
  "devDependencies": {
    "patch-package": "8.0.1"
  },
  "license": "UNLICENSED"
}
