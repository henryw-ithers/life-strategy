{
  "name": "glide",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "54.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-screens": "~4.16.0",
    "react-native-safe-area-context": "~5.6.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "test": "npm run test -w packages/scoring && npm run test -w packages/backup && npm run test -w apps/mobile",
    "typecheck": "npm run typecheck -w packages/scoring && npm run typecheck -w packages/backup && npm run typecheck -w apps/mobile",
    "mobile": "npm run start -w apps/mobile",
    "build:ios": "npm run eas:build -w apps/mobile",
    "submit:ios": "npm run eas:submit -w apps/mobile"
  },
  "version": "1.0.0",
  "devDependencies": {
    "patch-package": "8.0.1"
  }
}
